# executiond production environment. Copy this file to
#   scripts/private/<ssh-host>/executiond.env
# and replace every <CHANGE_ME>. That directory is git-ignored; keep the file
# mode 0600. scripts/deploy.sh uploads it to /etc/executiond/executiond.env and
# systemd loads it as the service EnvironmentFile.
#
# Only variables that require a deployment decision are listed here. Tuning
# knobs all have working defaults; see docs/configuration.md for the full set.

# --- Required: CLOB credentials ---
# The L2 API credentials (key/secret/passphrase) are derived from the signing
# key at startup and must not be configured here.
#
# The signing key is stored encrypted at rest in a sealed keystore file and decrypted
# once at startup. Create the two files next to this one, in
# scripts/private/<ssh-host>/, and deploy.sh ships them to the paths below:
#
#   cd <repo> && go build -o /tmp/polykey ./cmd/polykey
#   (umask 077; head -c 32 /dev/urandom | base64 > scripts/private/<host>/private-key.pass)
#   /tmp/polykey encrypt \
#     --key-file scripts/private/<host>/private-key.json \
#     --passphrase-file scripts/private/<host>/private-key.pass
#
# Both files must be mode 0600; deploy.sh checks that, and verifies the
# passphrase actually decrypts the key, before it uploads anything.
POLYMARKET_PRIVATE_KEY_FILE=/etc/executiond/private-key.json
POLYMARKET_PRIVATE_KEY_PASSPHRASE_FILE=/etc/executiond/private-key.pass

# The two paths above are where deploy.sh installs the bundle; the preflight
# rejects anything else, since the upload destinations are fixed.
#
# Development-only fallback: the raw hex key in plaintext. Setting it together
# with POLYMARKET_PRIVATE_KEY_FILE is an error, and deploy.sh warns when a
# production bundle uses it.
# POLYMARKET_PRIVATE_KEY=0x...

# --- Required when trading from a proxy wallet (Safe/deposit wallet) ---
# executiond signs as an EOA by default. If funds are held in a Polymarket
# proxy wallet, set both or orders are rejected. MAKER_ADDRESS is the proxy
# wallet address; SIGNATURE_TYPE is 1 (Poly proxy) or 2 (Gnosis Safe).
POLYMARKET_MAKER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=

# --- Optional: outbound network proxy (absolute http/https/socks5 URL) ---
POLYMARKET_PROXY_URL=

# --- Required: local dependencies ---
# The NATS server is the one pmm's deploy installs as pmm-nats.service.
EXECUTION_NATS_URL=nats://127.0.0.1:4222
EXECUTION_POSTGRES_URL=<CHANGE_ME>

# --- Optional risk gate. Empty means no cap on open BUY notional. ---
EXECUTION_MAX_OPEN_BUY_NOTIONAL_USD=
