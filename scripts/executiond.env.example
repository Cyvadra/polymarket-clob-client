# executiond production environment. Copy this file to
#   scripts/private/<ssh-host>/executiond.env
# and replace every <CHANGE_ME>. That directory is git-ignored; keep the file
# mode 0600. scripts/deploy.sh uploads it to /etc/executiond/executiond.env
# (/etc/executiond-<name>/ when deploy.env sets EXECUTIOND_INSTANCE=<name>).
#
# Only variables that require a deployment decision are listed here. Tuning
# knobs all have working defaults; see docs/configuration.md for the full set.

# --- Required: CLOB credentials ---
# The L2 API credentials (key/secret/passphrase) are derived from the signing
# key at startup and must not be configured here.
#
# The signing key is stored encrypted at rest in a sealed keystore file and decrypted
# once at startup. Create the two files next to this one, in
# scripts/private/<ssh-host>/, and deploy.sh ships them to the paths below:
#
#   cd <repo> && go build -o /tmp/polykey ./cmd/polykey
#   (umask 077; head -c 32 /dev/urandom | base64 > scripts/private/<host>/private-key.pass)
#   /tmp/polykey encrypt \
#     --key-file scripts/private/<host>/private-key.json \
#     --passphrase-file scripts/private/<host>/private-key.pass
#
# Both files must be mode 0600; deploy.sh checks that, and verifies the
# passphrase actually decrypts the key, before it uploads anything.
# With EXECUTIOND_INSTANCE=<name>, use /etc/executiond-<name>/ in both paths.
POLYMARKET_PRIVATE_KEY_FILE=/etc/executiond/private-key.json
POLYMARKET_PRIVATE_KEY_PASSPHRASE_FILE=/etc/executiond/private-key.pass

# The two paths above are where deploy.sh installs the bundle; the preflight
# rejects anything else, since the upload destinations are fixed.
#
# Development-only fallback: the raw hex key in plaintext. Setting it together
# with POLYMARKET_PRIVATE_KEY_FILE is an error, and deploy.sh warns when a
# production bundle uses it.
# POLYMARKET_PRIVATE_KEY=0x...

# --- Required when trading from a proxy wallet (Safe/deposit wallet) ---
# executiond signs as an EOA by default. If funds are held in a Polymarket
# proxy wallet, set both or orders are rejected. MAKER_ADDRESS is the proxy
# wallet address; SIGNATURE_TYPE is 1 (Poly proxy), 2 (Gnosis Safe) or
# 3 (deposit wallet, required for new accounts and by polywallet).
POLYMARKET_MAKER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=

# --- Optional: Polymarket relayer API key (deposit wallets, type 3, only) ---
# Used for gasless wallet operations: polywallet split/send, and executiond's
# split inventory (EXECUTION_INVENTORY_ENABLED). Create it in Polymarket under
# Settings > API Keys > Relayer API Keys. It can move the deposit wallet's
# funds, so treat it like the signing key.
POLYMARKET_RELAYER_API_KEY=
# The address the key was issued to; empty means the signing key's address.
POLYMARKET_RELAYER_API_KEY_ADDRESS=
# true takes split inventory requests and SPLIT_PRESERVE opens; executiond then
# refuses to start without the relayer key above.
EXECUTION_INVENTORY_ENABLED=

# --- Optional: Telegram destination for pnlreport (see scripts/README.md) ---
# Read only by pnlreport, never by executiond.
PNL_TELEGRAM_TOKEN=
PNL_TELEGRAM_CHAT_ID=
# Comma-separated pmm strategies.yaml paths; pnlreport reads exclusive_group from them.
PNL_STRATEGIES=

# --- Optional: outbound network proxy (absolute http/https/socks5 URL) ---
POLYMARKET_PROXY_URL=

# --- Required: local dependencies ---
# The NATS server is the one pmm's deploy installs as pmm-nats.service.
EXECUTION_NATS_URL=nats://127.0.0.1:4222
EXECUTION_POSTGRES_URL=<CHANGE_ME>

# --- Required: the strategies this wallet trades ---
# Preferred: keep per-strategy settings (allowlist, drawdown limits, size
# multipliers) in a JSON file; see scripts/strategies.json.example. deploy.sh
# ships private/<host>/strategies.json to this path. Setting it replaces
# EXECUTION_ALLOWED_STRATEGIES, EXECUTION_STRATEGY_*, EXECUTION_MAX_DRAWDOWN,
# EXECUTION_DRAWDOWN_START, EXECUTION_SIZE_AFTER_LOSS_ONLY,
# EXECUTION_MAX_OPEN_BUY_NOTIONAL_USD and EXECUTION_EQUITY_FLOW_THRESHOLD_USD,
# which must then be unset (they become keys of the file).
# EXECUTION_STRATEGIES_FILE=/etc/executiond/strategies.json
# Or, comma-separated:
# Several executiond instances may share one NATS server. Each acts only on
# requests whose "strategy" is listed here and silently ignores the rest, so
# give every strategy to one wallet only. Names are prefixes, and an Up/Down
# pair is listed by its prefix (CalmFavSimp, not CalmFavSimpUp,CalmFavSimpDown). A lone * trades
# every strategy: only for a wallet alone on its NATS server.
EXECUTION_ALLOWED_STRATEGIES=<CHANGE_ME>

# --- Optional risk gate. With EXECUTION_STRATEGIES_FILE, set all of these in the
# file instead and leave them unset here. ---
# Empty means no cap on open BUY notional.
EXECUTION_MAX_OPEN_BUY_NOTIONAL_USD=
# Suspend new opens when the trading drawdown since the start exceeds this
# limit: a percentage of the peak (20%) or dollars ('$500', single-quoted: this
# file is sourced by bash, which would expand $5); a bare 0.2 still
# reads as 20% but is deprecated. The start is required with it: YYYY-MM-DD or RFC 3339.
EXECUTION_MAX_DRAWDOWN=
# Per-strategy limits, strategy:limit pairs, e.g. late-gap:10%,momentum:$200.
# A strategy over its own limit has only its opens suspended. Each name must
# be in EXECUTION_ALLOWED_STRATEGIES. The start is required with these too.
EXECUTION_STRATEGY_MAX_DRAWDOWN=
# Limit for every allowed strategy not listed above, e.g. 10% or $200.
EXECUTION_STRATEGY_DEFAULT_MAX_DRAWDOWN=
EXECUTION_DRAWDOWN_START=

# --- Latency. Ping the CLOB this often to keep order connections warm (0 = startup only). ---
EXECUTION_KEEPWARM_INTERVAL=15s

# Prometheus /metrics. Unset = 127.0.0.1:9108; empty disables. Every
# executiond on one host needs its own port (pmm uses 9090-9096/9099), or
# deploy.sh refuses the second one.
# EXECUTION_METRICS_ADDR=127.0.0.1:9109
