# Optional per-host deploy overrides for scripts/deploy.sh. Copy this file to
#   scripts/private/<ssh-host>/deploy.env
# and adjust as needed; unset variables fall back to deploy.sh's defaults.
# That directory is git-ignored. This file is only read locally (by
# deploy.sh, before it SSHes to the host) and is never uploaded to the
# target; it holds no secrets.

# Path to the pm2 binary on the target host, used to (re)start the
# executiond pm2 app. Defaults to /root/.nvm/versions/node/v24.21.0/bin/pm2.
# Set this when a host's pm2/node version differs.
EXECUTIOND_PM2_BIN=/root/.nvm/versions/node/v24.21.0/bin/pm2

# --- Other optional overrides (rarely needed) ---
# EXECUTIOND_DEPLOY_TARGET=root
# EXECUTIOND_DEPLOY_ARCH=amd64
# EXECUTIOND_DEPLOY_OS=linux
