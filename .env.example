# executiond environment variables. Do not put real secrets in this file.
# Copy to an untracked .env file and source it before starting executiond.
# Only variables that require a deployment decision are listed here. Tuning
# knobs all have working defaults; see docs/configuration.md for the full set.

# --- Required: CLOB credentials ---
# The L2 API credentials (key/secret/passphrase) are derived from this private
# key at startup and must not be configured here.
POLYMARKET_PRIVATE_KEY=

# --- Required when trading from a proxy wallet (Safe/deposit wallet) ---
# executiond does not discover the proxy wallet; it signs as an EOA by default.
# If your funds are held in a Polymarket proxy wallet, set both of these or
# orders will be rejected. MAKER_ADDRESS is the proxy wallet address;
# SIGNATURE_TYPE is 1 (Poly proxy) or 2 (Gnosis Safe).
POLYMARKET_MAKER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=

# --- Optional: outbound network proxy (absolute http/https/socks5 URL) ---
POLYMARKET_PROXY_URL=

# --- Required: local dependencies ---
EXECUTION_NATS_URL=nats://127.0.0.1:4222
EXECUTION_POSTGRES_URL=postgres://user:password@127.0.0.1:5432/execution?sslmode=disable

# --- Optional risk gate. Empty means no cap on open BUY notional. ---
EXECUTION_MAX_OPEN_BUY_NOTIONAL_USD=
