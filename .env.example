# executiond requires these environment variables. Do not put real values in this file.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
EXECUTION_NATS_URL=nats://127.0.0.1:4222
EXECUTION_POSTGRES_URL=postgres://user:password@127.0.0.1:5432/execution?sslmode=disable

# Optional durations.
EXECUTION_POSITION_FEATURE_INTERVAL=500ms
EXECUTION_RECONCILE_INTERVAL=30s
EXECUTION_CONNECT_TIMEOUT=10s
EXECUTION_SHUTDOWN_GRACE_PERIOD=10s